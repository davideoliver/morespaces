APP_NAME=MoreSpaces
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/morespaces
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=morespaces
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_SECURE_COOKIE=false
# SESSION_SECURE_COOKIE=true
# Ative em produção quando a aplicação estiver servindo HTTPS.

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

BCRYPT_ROUNDS=12

SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
LEVELS_PER_PAGE=9